@@ -0,0 +1,209 @@
+import {
+  OAUTH_ERROR_FLOW_CANCELED,
+  OAUTH_ERROR_FLOW_TIMED_OUT,
+  OAuthPopupResult,
+  normalizeOAuthCredentialMeta,
+} from "@/lib/oauth-popup";
+
+export const MCP_OAUTH_PENDING_STORAGE_KEY = "mcp_oauth_pending_flow";
+export const MCP_OAUTH_PENDING_TTL_MS = 5 * 60 * 1000;
+export const MCP_OAUTH_POLL_INTERVAL_MS = 500;
+
+export interface PendingMcpOAuthFlow {
+  stateToken: string;
+  serverUrl: string;
+  createdAt: number;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
+
+function parsePendingFlow(value: string): PendingMcpOAuthFlow | null {
+  try {
+    const parsed: unknown = JSON.parse(value);
+    if (
+      !isRecord(parsed) ||
+      typeof parsed.stateToken !== "string" ||
+      typeof parsed.serverUrl !== "string" ||
+      typeof parsed.createdAt !== "number" ||
+      !Number.isFinite(parsed.createdAt)
+    ) {
+      return null;
+    }
+    return {
+      stateToken: parsed.stateToken,
+      serverUrl: parsed.serverUrl,
+      createdAt: parsed.createdAt,
+    };
+  } catch {
+    return null;
+  }
+}
+
+function getSessionStorage(): Storage | null {
+  try {
+    return typeof window === "undefined" ? null : window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+function getLocalStorage(): Storage | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+export function callbackStorageKey(stateToken: string): string {
+  return `oauth_popup_result_${stateToken}`;
+}
+
+export function savePendingMcpOAuthFlow(flow: PendingMcpOAuthFlow): void {
+  try {
+    getSessionStorage()?.setItem(
+      MCP_OAUTH_PENDING_STORAGE_KEY,
+      JSON.stringify(flow),
+    );
+  } catch {}
+}
+
+export function clearPendingMcpOAuthFlow(stateToken?: string): void {
+  const storage = getSessionStorage();
+  if (!storage) return;
+
+  try {
+    if (stateToken) {
+      const stored = storage.getItem(MCP_OAUTH_PENDING_STORAGE_KEY);
+      if (!stored) return;
+      const pending = parsePendingFlow(stored);
+      if (pending && pending.stateToken !== stateToken) return;
+    }
+    storage.removeItem(MCP_OAUTH_PENDING_STORAGE_KEY);
+  } catch {}
+}
+
+export function readPendingMcpOAuthFlow(
+  serverUrl: string,
+  now: number = Date.now(),
+): PendingMcpOAuthFlow | null {
+  const storage = getSessionStorage();
+  if (!storage) return null;
+
+  try {
+    const stored = storage.getItem(MCP_OAUTH_PENDING_STORAGE_KEY);
+    if (!stored) return null;
+    const pending = parsePendingFlow(stored);
+    if (
+      !pending ||
+      pending.serverUrl !== serverUrl ||
+      now - pending.createdAt > MCP_OAUTH_PENDING_TTL_MS
+    ) {
+      storage.removeItem(MCP_OAUTH_PENDING_STORAGE_KEY);
+      return null;
+    }
+    return pending;
+  } catch {
+    return null;
+  }
+}
+
+export function consumeMcpOAuthCallback(
+  stateToken: string,
+): OAuthPopupResult | null {
+  const storage = getLocalStorage();
+  if (!storage) return null;
+  const key = callbackStorageKey(stateToken);
+
+  try {
+    const stored = storage.getItem(key);
+    if (!stored) return null;
+    storage.removeItem(key);
+
+    const parsed: unknown = JSON.parse(stored);
+    if (
+      !isRecord(parsed) ||
+      parsed.message_type !== "mcp_oauth_result" ||
+      parsed.success !== true ||
+      parsed.state !== stateToken
+    ) {
+      return null;
+    }
+    const credential = normalizeOAuthCredentialMeta(parsed.credential);
+    if (credential) {
+      return { credential, state: stateToken };
+    }
+    if (typeof parsed.code === "string" && parsed.code.length > 0) {
+      return { code: parsed.code, state: stateToken };
+    }
+    return null;
+  } catch {
+    try {
+      storage.removeItem(key);
+    } catch {}
+    return null;
+  }
+}
+
+interface WaitForMcpOAuthCallbackArgs {
+  stateToken: string;
+  signal: AbortSignal;
+  timeoutMs?: number;
+}
+
+export function waitForMcpOAuthCallback({
+  stateToken,
+  signal,
+  timeoutMs = MCP_OAUTH_PENDING_TTL_MS,
+}: WaitForMcpOAuthCallbackArgs): Promise<OAuthPopupResult> {
+  const immediateResult = consumeMcpOAuthCallback(stateToken);
+  if (immediateResult) return Promise.resolve(immediateResult);
+  if (signal.aborted) {
+    return Promise.reject(new Error(OAUTH_ERROR_FLOW_CANCELED));
+  }
+
+  return new Promise((resolve, reject) => {
+    let completed = false;
+
+    function cleanup() {
+      clearInterval(pollInterval);
+      clearTimeout(timeoutId);
+      signal.removeEventListener("abort", handleAbort);
+    }
+
+    function finish(result: OAuthPopupResult) {
+      if (completed) return;
+      completed = true;
+      cleanup();
+      resolve(result);
+    }
+
+    function fail(message: string) {
+      if (completed) return;
+      completed = true;
+      cleanup();
+      reject(new Error(message));
+    }
+
+    function checkForResult() {
+      const result = consumeMcpOAuthCallback(stateToken);
+      if (result) finish(result);
+    }
+
+    function handleAbort() {
+      fail(OAUTH_ERROR_FLOW_CANCELED);
+    }
+
+    const pollInterval = setInterval(
+      checkForResult,
+      MCP_OAUTH_POLL_INTERVAL_MS,
+    );
+    const timeoutId = setTimeout(
+      () => fail(OAUTH_ERROR_FLOW_TIMED_OUT),
+      Math.max(0, timeoutMs),
+    );
+    signal.addEventListener("abort", handleAbort, { once: true });
+  });
+}
