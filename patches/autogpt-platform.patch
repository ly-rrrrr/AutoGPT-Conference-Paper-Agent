+def _infer_json_schema(value: Any) -> dict[str, Any]:
+    if isinstance(value, bool):
+        return {"type": "boolean"}
+    if isinstance(value, int):
+        return {"type": "integer"}
+    if isinstance(value, float):
+        return {"type": "number"}
+    if isinstance(value, str):
+        return {"type": "string"}
+    if isinstance(value, date):
+        return {"type": "string", "format": "date"}
+    if isinstance(value, time):
+        return {"type": "string", "format": "time"}
+    if isinstance(value, list):
+        item_schemas = [_infer_json_schema(item) for item in value]
+        distinct_item_schemas: list[dict[str, Any]] = []
+        for item_schema in item_schemas:
+            if item_schema not in distinct_item_schemas:
+                distinct_item_schemas.append(item_schema)
+        if not item_schemas:
+            items: dict[str, Any] = {"type": "string"}
+        elif len(distinct_item_schemas) == 1:
+            items = distinct_item_schemas[0]
+        else:
+            items = {"anyOf": distinct_item_schemas}
+        return {"type": "array", "items": items}
+    if isinstance(value, dict):
+        return {
+            "type": "object",
+            "properties": {
+                str(key): _infer_json_schema(item) for key, item in value.items()
+            },
+            "additionalProperties": False,
+        }
+    return {}
+
