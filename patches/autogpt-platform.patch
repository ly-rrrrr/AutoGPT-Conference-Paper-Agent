@@ -0,0 +1,106 @@
+import type {
+  CredentialsMetaInput,
+  CredentialsMetaResponse,
+} from "@/lib/autogpt-server-api/types";
+import { resolveMcpOAuthResult } from "@/lib/oauth-popup";
+import { useEffect, useRef } from "react";
+import {
+  MCP_OAUTH_PENDING_TTL_MS,
+  clearPendingMcpOAuthFlow,
+  readPendingMcpOAuthFlow,
+  waitForMcpOAuthCallback,
+} from "./mcp-oauth-recovery";
+
+interface Params {
+  enabled: boolean;
+  serverUrl?: string;
+  selectedCredential?: CredentialsMetaInput;
+  mcpOAuthCallback?: (
+    code: string,
+    stateToken: string,
+  ) => Promise<CredentialsMetaResponse>;
+  mcpOAuthComplete?: (
+    credential: CredentialsMetaResponse,
+  ) => Promise<CredentialsMetaResponse>;
+  onSelectCredential: (newValue?: CredentialsMetaInput) => void;
+  onError: (message: string | null) => void;
+}
+
+export function useMcpOAuthRecovery({
+  enabled,
+  serverUrl,
+  selectedCredential,
+  mcpOAuthCallback,
+  mcpOAuthComplete,
+  onSelectCredential,
+  onError,
+}: Params): void {
+  const attemptedStateRef = useRef<string | null>(null);
+
+  useEffect(() => {
+    if (!enabled || !serverUrl || !mcpOAuthCallback) return;
+
+    const pending = readPendingMcpOAuthFlow(serverUrl);
+    if (!pending) {
+      if (selectedCredential && !selectedCredential.id) {
+        onSelectCredential(undefined);
+      }
+      return;
+    }
+    if (attemptedStateRef.current === pending.stateToken) return;
+    const pendingFlow = pending;
+    const exchangeMcpOAuthCode = mcpOAuthCallback;
+    attemptedStateRef.current = pendingFlow.stateToken;
+
+    const controller = new AbortController();
+    const remainingTimeout = Math.max(
+      0,
+      MCP_OAUTH_PENDING_TTL_MS - (Date.now() - pendingFlow.createdAt),
+    );
+
+    async function recoverCredential() {
+      try {
+        const result = await waitForMcpOAuthCallback({
+          stateToken: pendingFlow.stateToken,
+          signal: controller.signal,
+          timeoutMs: remainingTimeout,
+        });
+        const credential = await resolveMcpOAuthResult(
+          result,
+          exchangeMcpOAuthCode,
+          mcpOAuthComplete,
+        );
+        if (controller.signal.aborted) return;
+        onSelectCredential({
+          id: credential.id,
+          type: "oauth2",
+          title: credential.title,
+          provider: "mcp",
+        });
+        onError(null);
+      } catch (error) {
+        if (controller.signal.aborted) return;
+        const message = error instanceof Error ? error.message : String(error);
+        onError(`OAuth error: ${message}`);
+        if (selectedCredential && !selectedCredential.id) {
+          onSelectCredential(undefined);
+        }
+      } finally {
+        if (!controller.signal.aborted) {
+          clearPendingMcpOAuthFlow(pendingFlow.stateToken);
+        }
+      }
+    }
+
+    void recoverCredential();
+    return () => controller.abort();
+  }, [
+    enabled,
+    serverUrl,
+    selectedCredential,
+    mcpOAuthCallback,
+    mcpOAuthComplete,
+    onSelectCredential,
+    onError,
+  ]);
+}
